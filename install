#!/bin/bash

resolve()
{
    head=$(git ls-tree HEAD "$1" |cut -f 1|cut -d ' ' -f 3)
    echo "$1: versions differ"
    while true; do
        state "$PWD/$1" "git working copy"
        state "$HOME/$1" "installed"
        echo "    r - replace installed version with git working copy"
        echo "    u - replace git working copy with installed version"
        echo "    d - show differences"
        echo "    s - skip"
        echo "    q - quit"
        echo -n "Select action: "
        read -e answer
        case "$answer" in
        q|Q)
            exit
            ;;
        s|S)
            ;;
        d|D)
            diff -u "$HOME/$1" "$PWD/$1"
            continue
            ;;
        u|U)
            cp "$HOME/$1" "$PWD/$1"
            ;;
        r|R)
            cp "$PWD/$1" "$HOME/$1"
            ;;
        *)
            continue
            ;;
        esac
        break;
    done
}

state()
{
    if [ -e "$1" ]; then
        size=$(wc -c < "$1")
        fhash=$(git hash-object "$1")
        if [ "_$fhash" = "_$head" ]; then
            echo "    $2 version matches HEAD, $size bytes"
        elif git cat-file -e $fhash; then
            echo "    $2 version is in git, but not at HEAD, $size bytes"
        else
            echo "    $2 version is not in git history, $size bytes"
        fi
    else
        echo "    no $2 version"
    fi
}

# Idempotently ensure ~/$1 sources the tracked config ~/$2, by appending a
# marker-delimited block. These shell-startup files (.zshrc, .zprofile) are
# left untracked and installer-owned (brew, nvm, conda, rustup, ... append to
# them), so we never copy over them -- we only inject a source block once.
# The block uses if/then (not &&) so a missing file leaves $? = 0; otherwise a
# trailing failed test would color the first prompt's last-command indicator.
ensure_block()
{
    target="$HOME/$1"
    marker="# mattkenney-dotfiles: source ~/$2"
    if [ -f "$target" ] && grep -qF "$marker" "$target"; then
        return
    fi
    printf '\n%s\nif [ -r "$HOME/%s" ]; then\n    . "$HOME/%s"\nfi\n' "$marker" "$2" "$2" >> "$target"
    echo "install: added managed block to ~/$1 (sources ~/$2)"
}

cd "$( cd "$( dirname "$0" )" && pwd )/files"
files=$( \
    find . -type f \
    |LC_ALL=C sort|sed "s/^\.\///" \
)
for file in $files; do
    if [ "${file%%/*}" == Library ] && [ "$(uname)" != Darwin ]; then
        continue
    fi
    homefile="$HOME/$file"
    parent="${homefile%/*}"

    if ! cmp --silent "$homefile" "$file"; then
        if [ ! -e "$homefile" ]; then
            mkdir -p "$parent"
            cp "$file" "$homefile"
        else
            resolve $file
        fi
    fi
done

# zsh startup files stay installer-owned; just wire in our tracked config.
ensure_block .zprofile .config/shell/zprofile.zsh
ensure_block .zshrc    .config/shell/zshrc.zsh
