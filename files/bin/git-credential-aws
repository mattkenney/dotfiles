#!/bin/sh
#
# git credential helper backed by AWS SSM Parameter Store (SecureString).
#
# The parameter name is derived from the host git is authenticating to, and
# from credential.username when one is configured:
#
#   https://github.com/matt/foo   ->  /git-credentials/github.com
#   ...as alice                   ->  /git-credentials/github.com/alice
#
# With credential.useHttpPath set, the repo path is appended too, giving one
# parameter per repo. There is no fallback: configuring a username moves the
# lookup rather than adding a second one, so print what a host resolves to
# before seeding it.
#
#   git-credential-aws --name github.com
#
# Parameter values are "username:password" (split on the first colon). A value
# with no colon is treated as a bare token, paired with the username git asked
# for, or x-access-token.
#
# Environment:
#   GIT_CREDENTIAL_AWS_PREFIX  parameter prefix   (default /git-credentials)
#   GIT_CREDENTIAL_AWS_KEY_ID  KMS key for writes (default alias/aws/ssm)
#
# Install:
#   git-credential-aws --install <username>
#
# That sets credential.username and registers this script in ~/.gitconfig,
# behind a short-lived credential cache so a warm cache costs no API call.
# Order matters there: git takes the first helper that answers, so a cache
# added afterwards could never do so.
#
# The username is required. Hosts authenticating as different users would
# otherwise share one parameter and overwrite each other, and git config
# carries it to cron and systemd callers in a way the environment does not.
#
# ~/.gitconfig is the untracked half of the split these dotfiles use:
# ~/.config/git/config is tracked, git reads ~/.gitconfig second, and
# single-valued settings there win. Writing to it explicitly keeps
# machine-local settings out of the tracked file, which is also what
# git-set-user does and for the same reason.
#
# The registration records an absolute path, so the helper still resolves for
# cron and systemd callers whose PATH lacks ~/bin. It is not scoped to a host:
# an unstored one prints ParameterNotFound and falls through to a prompt, which
# only happens when a server actually asks for credentials.
#
# Instance role policy. Read-only hosts are made read-only by dropping
# ssm:PutParameter and kms:Encrypt here, not by anything in this script. Note
# that parameter ARNs omit the leading slash of the parameter name:
#
#   {
#     "Version": "2012-10-17",
#     "Statement": [
#       { "Effect": "Allow",
#         "Action": ["ssm:GetParameter", "ssm:PutParameter"],
#         "Resource": "arn:aws:ssm:REGION:ACCT_ID:parameter/git-credentials/*"
#       },
#       { "Effect": "Allow",
#         "Action": ["kms:Decrypt", "kms:Encrypt"],
#         "Resource": "*",
#         "Condition": {
#           "StringEquals": { "kms:ViaService": "ssm.REGION.amazonaws.com" }
#         }
#       }
#     ]
#   }
#
# Portable to any distro with a POSIX sh and the aws CLI, v1 or v2 (Amazon
# Linux 2 ships v1, AL2023 and Ubuntu's snap ship v2). The CLI must be able to
# resolve a region on its own: set one in ~/.aws/config or export
# AWS_DEFAULT_REGION, rather than relying on IMDS.
#

set -eu
umask 077

prefix=${GIT_CREDENTIAL_AWS_PREFIX:-/git-credentials}
prefix=${prefix%/}

host= path= username= password=

# SSM parameter names allow only [a-zA-Z0-9_.-], plus / as the hierarchy
# separator. Fold anything else so odd hosts, users and paths can't produce a
# name the API rejects, or escape the prefix.
sanitize() { printf '%s' "$1" | LC_ALL=C tr -c 'a-zA-Z0-9_.-' '_'; }

build_name() {
    name="$prefix/$(sanitize "$host")"

    if [ -n "$username" ]; then
        name="$name/$(sanitize "$username")"
    fi

    if [ -n "$path" ]; then
        saved_ifs=$IFS
        set -f          # split $path on / without globbing
        IFS=/
        set -- $path
        IFS=$saved_ifs
        set +f
        for segment do
            case $segment in
                ''|.|..) continue ;;
            esac
            name="$name/$(sanitize "$segment")"
        done
    fi
}

case ${1:-} in
--install)
    username=${2:-}
    if [ -z "$username" ]; then
        echo "usage: git-credential-aws --install <username>" >&2
        exit 2
    fi
    self=$(cd "$(dirname "$0")" && pwd)/$(basename "$0")

    GIT_CONFIG_GLOBAL=~/.gitconfig \
        git config --global credential.username "$username"

    # Clear only entries this script owns, so an osxkeychain or libsecret
    # helper alongside it survives. --unset-all exits 5 when nothing matches,
    # which is the usual case on a first run.
    for owned in '^cache ' git-credential-aws; do
        GIT_CONFIG_GLOBAL=~/.gitconfig \
            git config --global --unset-all credential.helper "$owned" || true
    done

    for helper in 'cache --timeout=3600' "$self"; do
        GIT_CONFIG_GLOBAL=~/.gitconfig \
            git config --global --add credential.helper "$helper"
    done

    echo "~/.gitconfig:"
    echo "  username = $username"
    GIT_CONFIG_GLOBAL=~/.gitconfig \
        git config --global --get-all credential.helper | sed 's/^/  helper   = /'
    exit 0
    ;;

--name)
    # What get would look up for this host, for seeding with put-parameter.
    host=${2:-}
    if [ -z "$host" ]; then
        echo "usage: git-credential-aws --name <host>" >&2
        exit 2
    fi
    username=$(git config credential.username || true)
    build_name
    echo "$name"
    exit 0
    ;;
esac

# "erase" is deliberately unimplemented, and falls through to the no-op below.
# Git issues it on a 401. Deleting a genuinely dead token would gain nothing,
# so the only cases where honouring it is not a no-op are the ones where it
# does damage: a 401 from an intermediary discards a token that was fine, and
# a client on one instance destroys a parameter that was provisioned centrally.
# Retire a credential with aws ssm delete-parameter instead.
op=${1:-}
case $op in
    get|store) ;;
    *) exit 0 ;;
esac

# Read the key=value request from git, terminated by a blank line or EOF.
while IFS='=' read -r key value; do
    [ -n "$key" ] || break
    case $key in
        host)     host=$value ;;
        path)     path=$value ;;
        username) username=$value ;;
        password) password=$value ;;
    esac
done

[ -n "$host" ] || exit 0

build_name

case $op in
get)
    # stderr is left alone on purpose: every failure below exits 0 and falls
    # through to a prompt, so what the CLI prints is the only thing separating
    # a denied or misconfigured role from a host with nothing stored. The cost
    # is that an ordinary miss prints ParameterNotFound too.
    value=$(aws ssm get-parameter \
        --name "$name" \
        --with-decryption \
        --query Parameter.Value \
        --output text) || exit 0

    stored_username=${value%%:*}
    stored_password=${value#*:}
    if [ "$stored_password" = "$value" ]; then      # no colon: bare token
        stored_username=${username:-x-access-token}
        stored_password=$value
    fi

    # The username is part of the name, so a mismatch here means the parameter
    # holds someone else's credential. Decline rather than authenticate as them.
    if [ -n "$username" ] && [ "$username" != "$stored_username" ]; then
        exit 0
    fi

    printf 'username=%s\npassword=%s\n' "$stored_username" "$stored_password"
    ;;

store)
    # Git only issues this once a credential has authenticated successfully,
    # so there is no risk of persisting a typo.
    [ -n "$password" ] || exit 0

    # Pass the secret via --value file://... rather than inline: argv is
    # world-readable through /proc/<pid>/cmdline while the CLI runs.
    tmp=$(mktemp)
    trap 'rm -f "$tmp"' EXIT
    printf '%s:%s' "$username" "$password" >"$tmp"

    aws ssm put-parameter \
        --name "$name" \
        --type SecureString \
        --key-id "${GIT_CREDENTIAL_AWS_KEY_ID:-alias/aws/ssm}" \
        --value "file://$tmp" \
        --overwrite >/dev/null
    ;;
esac
